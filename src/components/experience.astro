---
import { Image } from "astro:assets";
import bs23 from "../../public/bs23-logo.jpg";
import dal from "../../public/dal-light.png";

interface Experience {
  role: string;
  image: ImageMetadata;
  logoClass: "dal" | "bs23";
  institution: string;
  year: string;
  summary: string;
  points: string[];
}

const experiences: Experience[] = [
  {
    role: "Research Assistant",
    image: dal,
    logoClass: "dal",
    institution: "Dalhousie University · Halifax",
    year: "2023–2025",
    summary:
      "I worked at the intersection of software engineering and simulation research, focusing on code quality, refactoring practices, and practical improvements to research software.",
    points: [
      "Compared code quality across 155 simulation and 327 traditional projects for SCAM 2024.",
      "Studied refactoring practices across large-scale simulation repositories for TRBAM 2026.",
      "Improved in-house simulation software by addressing code-quality issues and contributing critical features.",
    ],
  },
  {
    role: "Associate Software Engineer",
    image: bs23,
    logoClass: "bs23",
    institution: "Brain Station 23",
    year: "2022–2023",
    summary:
      "I built and maintained client-facing web and mobile products while working across application development, deployment, and legacy codebases.",
    points: [
      "Built full-stack web and mobile applications using Angular, Laravel, and Ionic.",
      "Deployed containerized applications and provisioned Linux environments with Docker and CI/CD.",
      "Developed Moodle and WordPress plugins, including an Ionic interface for parsing Moodle HTML.",
      "Improved reliability and reduced technical debt with unit and integration test suites.",
    ],
  },
];
---

<section
  class="border-t-2 border-[var(--white-icon-tr)] px-4 py-20 text-[var(--white)] md:px-8 md:py-28"
  id="experience"
>
  <div class="mx-auto max-w-5xl">
    <header class="max-w-2xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Career
      </p>
      <h2 class="text-4xl font-medium tracking-tight md:text-6xl">
        Experience
      </h2>
      <p
        class="mt-5 max-w-xl text-base leading-relaxed text-[var(--white-icon)] md:text-lg"
      >
        A path from building client products to researching how software can be
        made better.
      </p>
    </header>

    <div class="relative mt-12 md:mt-16">
      <div
        class="absolute bottom-0 left-[6.5rem] top-0 hidden w-px bg-[var(--white-icon-tr)] sm:block md:left-28"
        aria-hidden="true"
      >
      </div>

      {
        experiences.map((item) => (
          <article
            class:list={[
              "relative grid grid-cols-1 gap-3 py-10 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:gap-6 sm:py-12 md:grid-cols-[7rem_minmax(0,1fr)] md:gap-10"
            ]}
          >
            <div class="relative flex  sm:justify-end items-start">
              <time class="text-xs md:text-sm font-medium uppercase tracking-[0.12em] text-[var(--white-icon)]">
                {item.year}
              </time>
              <span
                class="relative z-10 hidden size-3 shrink-0 translate-x-1/2 rounded-full border-4 border-[var(--background)] bg-[var(--sec)] sm:block"
                aria-hidden="true"
              />
            </div>

            <div class="min-w-0">
              <h3 class="text-2xl font-semibold tracking-tight md:text-3xl">
                {item.role}
              </h3>

              <div class="mt-2 flex items-center gap-2 text-sm text-[var(--white-icon)] md:text-base">
                <span
                  class:list={[
                    "flex size-9 shrink-0 items-center justify-center rounded-full border border-[var(--white-icon-tr)] bg-[var(--white-icon-tr)] p-0.5"
                  ]}
                >
                  <Image
                    src={item.image}
                    alt=""
                    aria-hidden="true"
                    class:list={[
                      "size-full object-contain",
                      item.logoClass === "bs23" && "rounded-full object-cover",
                      item.logoClass === "dal" && "dark:brightness-0 dark:invert",
                    ]}
                  />
                </span>
                <span>{item.institution}</span>
              </div>

              <p class="mt-6 max-w-3xl text-base leading-relaxed text-[var(--white)] md:text-lg">
                {item.summary}
              </p>

              <ul class="mt-5 max-w-3xl list-disc space-y-2 pl-5 text-sm leading-relaxed text-[var(--white-icon)] marker:text-[var(--sec)] md:text-base">
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
