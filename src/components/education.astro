---
import { Image } from "astro:assets";
import bracu from "../../public/bracu_alt.png";
import dal from "../../public/dal-light.png";

interface Education {
  degree: string;
  image: ImageMetadata;
  logoClass: "dal" | "bracu";
  institution: string;
  date: string;
  dateValue: string;
}

const educations: Education[] = [
  {
    degree: "Master of Computer Science",
    image: dal,
    logoClass: "dal",
    institution: "Dalhousie University",
    date: "October 2025",
    dateValue: "2025-10",
  },
  {
    degree: "Bachelor of Computer Science and Engineering",
    image: bracu,
    logoClass: "bracu",
    institution: "BRAC University",
    date: "November 2021",
    dateValue: "2021-11",
  },
];
---

<section
  class="border-t-2 border-[var(--white-icon-tr)] px-4 py-20 text-[var(--white)] md:px-8 md:py-28"
  id="education"
>
  <div class="mx-auto max-w-5xl">
    <header class="mb-12 border-b border-[var(--white-icon-tr)] pb-6">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Background
      </p>
      <h2 class="text-4xl font-medium tracking-tight md:text-6xl">Education</h2>
    </header>

    <div class="border-b border-[var(--white-icon-tr)]">
      {
        educations.map((item, index) => (
          <article
            class:list={[
              "grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-x-4 gap-y-3 py-7 md:grid-cols-[4.5rem_minmax(0,1fr)_auto] md:gap-x-8 md:py-8",
              index > 0 && "border-t border-[var(--white-icon-tr)]",
            ]}
          >
            <div
              class:list={[
                "flex size-12 shrink-0 items-center justify-center rounded-full border border-[var(--white-icon-tr)] bg-[var(--white-icon-tr)] p-1.5 md:size-14",
                item.logoClass === "dal" && "dark:bg-[var(--background)]",
                item.logoClass === "bracu" && "dark:bg-[var(--white)]",
              ]}
            >
              <Image
                src={item.image}
                alt=""
                aria-hidden="true"
                class:list={[
                  "size-full object-contain",
                  item.logoClass === "bracu" && "rounded-full",
                  item.logoClass === "dal" && "dark:brightness-0 dark:invert",
                ]}
              />
            </div>

            <div class="min-w-0">
              <h3 class="text-lg font-medium tracking-tight md:text-2xl">
                {item.degree}
              </h3>
              <p class="mt-1 text-sm text-[var(--white-icon)] md:text-base">
                {item.institution}
              </p>
            </div>

            <time
              class="col-start-2 row-start-2 text-xs font-medium uppercase tracking-[0.12em] text-[var(--white-icon)] md:col-start-3 md:row-start-1 md:justify-self-end md:text-sm"
              datetime={item.dateValue}
            >
              {item.date}
            </time>
          </article>
        ))
      }
    </div>
  </div>
</section>
