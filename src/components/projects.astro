---
type MediaType = "video" | "image" | "placeholder";

interface Project {
  title: string;
  slug: string;
  link: string;
  mediaType: MediaType;
  image?: string;
  poster?: string;
  summary: string;
  highlights: string[];
  tags: string[];
}

const projects: Project[] = [
  {
    title: "Aergia",
    slug: "aergia",
    link: "https://github.com/riasat-mahbub/aergia-new",
    mediaType: "video",
    poster: "/videos/aergia-poster.webp",
    summary:
      "A CV builder that makes the path from editing to a finished PDF feel direct.",
    highlights: [
      "Built a self-hosted full-stack CV platform for reusable career library, application tracking, PDF import/export, and tailored resume generation using Tanstack start, React, FastAPI and Playwright.",
      "Developed a customizable document engine with drag-and-drop editing, multiple templates, and synchronized live preview and PDF rendering.",
      "Built a local requirement-analysis pipeline using GLiNER2 to match job requirements against candidate evidence and generate editable, tailored CVs.",
    ],
    tags: ["React", "FastAPI", "PDF Generation", "SQLite", "Resume Builder", "TanStack", "Docker", "Vite", "Playwright"],
  },
  {
    title: "Project Tracker",
    slug: "project-tracker",
    link: "https://github.com/riasat-mahbub/project-tracker-unified",
    mediaType: "video",
    poster: "/videos/project-tracker-poster.webp",
    summary:
      "A reusable memory layer that helps coding agents keep project context close to the work.",
    highlights: [
      "Built a persistent knowledge-graph system for AI coding agents, linking bugs, features, tasks, decisions,affected files, dependencies, and backlinks across a codebase.",
      "Developed a CLI for creating, updating, searching, validating, rebuilding, and repairing project state, with generated dashboards and machine-readable graph output.",
      "Implemented BM25, fuzzy, regex, and exact-phrase search to help agents retrieve relevant project context before making code changes.",
    ],
    tags: [
      "Skill",
      "Markdown",
      "YAML",
      "Knowledge Graph",
      "Python",
      "Information Retrieval",
      "BM25",
      "JSON",
    ],
  },
  {
    title: "MBuddy",
    slug: "mbuddy",
    link: "https://github.com/riasat-mahbub/MBuddy",
    mediaType: "image",
    image: "/images/MBuddy.png",
    summary: "A unified media database for unusually specific recommendations.",
    highlights: [
      "Indexes manga, anime, manhwa, games, movies, TV, and novels in one catalog.",
      "Uses semantic search across 189,000+ entries to make discovery feel natural.",
      "Ingests data from five sources with a FastAPI and SQLite backend.",
    ],
    tags: ["Python", "FastAPI", "SQLite", "Embeddings", "Recommender"],
  },
];
---

<section
  class="border-t-2 border-[var(--white-icon-tr)] px-4 py-20 text-[var(--white)] md:px-8 md:py-28"
  id="projects"
>
  <div class="mx-auto max-w-site">
    <header class="max-w-2xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Selected work
      </p>
      <h2 class="text-4xl font-medium tracking-tight md:text-6xl">Projects</h2>
      <p
        class="mt-5 max-w-xl text-base leading-relaxed text-[var(--white-icon)] md:text-lg"
      >
        Products, tools, and experiments built around making complicated things
        easier to use.
      </p>
    </header>

    <div class="mt-12 md:mt-16">
      {
        projects.map((project, index) => (
          <article
            class:list={[
              "project-row grid gap-8 border-t border-[var(--white-icon-tr)] py-12 md:gap-10 md:py-16 lg:grid-cols-2 lg:items-center lg:gap-20 lg:py-20",
              index % 2 === 1 && "project-row--reversed",
              index === projects.length - 1 && "border-b",
            ]}
          >
            <div class="project-media relative aspect-[8/5] overflow-hidden rounded-xl border border-[var(--white-icon-tr)] bg-[var(--white-icon-tr)] shadow-lg">
              <div
                class="project-media-fallback absolute inset-0 flex flex-col justify-between p-5 md:p-7"
                aria-hidden="true"
              >
                <span class="text-sm font-semibold tracking-[0.2em] text-[var(--sec)]">
                  0{index + 1}
                </span>
                <div>
                  <p class="text-2xl font-semibold tracking-tight md:text-3xl">
                    {project.title}
                  </p>
                  <p class="mt-2 text-sm text-[var(--white-icon)]">
                    Project demo
                  </p>
                </div>
              </div>

              {project.mediaType === "video" && project.poster && (
                <img
                  class="project-poster absolute inset-0 z-10 size-full bg-[var(--background)] object-contain transition-opacity duration-500"
                  data-project-poster
                  src={project.poster}
                  alt=""
                  aria-hidden="true"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              )}

              {project.mediaType === "video" && (
                <video
                  class="project-video absolute inset-0 z-20 size-full bg-[var(--background)] object-contain opacity-0 transition-opacity duration-500"
                  data-project-video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={project.poster}
                  aria-hidden="true"
                >
                  <source
                    data-src={`/videos/${project.slug}.webm`}
                    type="video/webm"
                  />
                  <source
                    data-src={`/videos/${project.slug}.mp4`}
                    type="video/mp4"
                  />
                  Your browser does not support embedded videos.
                </video>
              )}
              {project.mediaType === "image" && project.image && (
                <img
                  class="project-image absolute inset-0 z-20 size-full object-cover opacity-0 transition-opacity duration-500"
                  data-project-image
                  src={project.image}
                  alt={`${project.title} project preview`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>

            <div class="project-copy min-w-0">
              <div class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--white-icon)]">
                <span class="text-[var(--sec)]">0{index + 1}</span>
                <span
                  class="h-px w-8 bg-[var(--white-icon-tr)]"
                  aria-hidden="true"
                />
                <span>Open source</span>
              </div>

              <h3 class="text-3xl font-semibold tracking-tight md:text-4xl">
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors duration-300 hover:text-[var(--sec)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
                >
                  {project.title}
                </a>
              </h3>

              <p class="mt-4 text-lg leading-relaxed text-[var(--white)]">
                {project.summary}
              </p>

              <ul class="mt-6 space-y-3 text-sm leading-relaxed text-[var(--white-icon)] md:text-base">
                {project.highlights.map((highlight) => (
                  <li class="flex gap-3">
                    <span
                      class="mt-[0.65em] size-1.5 shrink-0 rounded-full bg-[var(--sec)]"
                      aria-hidden="true"
                    />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-7 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="border border-[var(--white-icon-tr)] px-2.5 py-1 text-xs text-[var(--white-icon)]">
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--white)] transition-colors duration-300 hover:text-[var(--sec)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
              >
                View on GitHub
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  <path d="M5 12h13" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center md:mt-16">
      <a
        href="https://github.com/riasat-mahbub?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 border border-[var(--white-icon-tr)] px-5 py-3 text-sm font-semibold text-[var(--white-icon)] transition-colors duration-300 hover:border-[var(--sec)] hover:text-[var(--white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
      >
        More projects on GitHub
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h13"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const projectPosters = document.querySelectorAll<HTMLImageElement>(
    "[data-project-poster]",
  );
  const projectVideos = document.querySelectorAll<HTMLVideoElement>(
    "[data-project-video]",
  );
  const projectImages = document.querySelectorAll<HTMLImageElement>(
    "[data-project-image]",
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const loadProjectVideo = (video: HTMLVideoElement) => {
    if (video.dataset.videoLoaded === "true") return;

    video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach(
      (source) => {
        source.src = source.dataset.src ?? "";
      },
    );

    video.dataset.videoLoaded = "true";
    video.load();
  };

  projectPosters.forEach((poster) => {
    poster.addEventListener(
      "error",
      () => poster.classList.add("is-unavailable"),
      { once: true },
    );
  });

  const videoObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target as HTMLVideoElement;

              if (entry.isIntersecting) {
                loadProjectVideo(video);
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { rootMargin: "300px 0px", threshold: 0.01 },
        )
      : null;

  projectVideos.forEach((video) => {
    const poster = video.parentElement?.querySelector<HTMLImageElement>(
      "[data-project-poster]",
    );

    video.addEventListener(
      "canplay",
      () => {
        video.classList.add("is-ready");
        poster?.classList.add("is-video-ready");
      },
      { once: true },
    );
    video.addEventListener(
      "error",
      () => {
        video.classList.add("is-unavailable");
        poster?.classList.remove("is-video-ready");
      },
      { once: true },
    );

    if (prefersReducedMotion) {
      video.pause();
      return;
    }

    if (videoObserver) {
      videoObserver.observe(video);
    } else {
      loadProjectVideo(video);
      video.play().catch(() => {});
    }
  });

  projectImages.forEach((image) => {
    image.addEventListener("load", () => image.classList.add("is-ready"), {
      once: true,
    });
    image.addEventListener(
      "error",
      () => image.classList.add("is-unavailable"),
      { once: true },
    );

    if (image.complete && image.naturalWidth > 0) {
      image.classList.add("is-ready");
    }
  });
</script>

<style>
  .project-media {
    isolation: isolate;
  }

  .project-row--reversed .project-media {
    order: 2;
  }

  .project-row--reversed .project-copy {
    order: 1;
  }

  .project-media-fallback {
    background:
      radial-gradient(circle at 90% 10%, var(--white-icon-tr), transparent 42%),
      var(--background);
  }

  .project-poster.is-video-ready {
    opacity: 0;
    pointer-events: none;
  }

  .project-video.is-ready,
  .project-image.is-ready {
    opacity: 1;
  }

  .project-poster.is-unavailable,
  .project-video.is-unavailable,
  .project-image.is-unavailable {
    display: none;
  }

  @media (max-width: 1023px) {
    .project-row--reversed .project-media,
    .project-row--reversed .project-copy {
      order: initial;
    }
  }
</style>
