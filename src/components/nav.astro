---
import ThemeToggle from "@/components/theme-toggle.astro";

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Home", href: "#home" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Blog", href: "#blog" },
  { label: "Research", href: "#research" },
  { label: "Education", href: "#education" },
  { label: "Connect", href: "#connect" },
];
---

<div class="fixed inset-x-0 top-0 z-[100] px-4 pt-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16">
  <nav
    id="main-nav"
    class="site-header mx-auto flex w-full max-w-site items-center justify-between gap-4 rounded-xl border border-transparent px-1 py-2 transition-[background-color,border-color,box-shadow] duration-300 sm:px-2 lg:gap-6"
    aria-label="Primary navigation"
  >
    <a
      href="#home"
      aria-label="Riasat Mahbub — Home"
      class="group flex min-w-0 shrink-0 items-center gap-2 text-[var(--white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
    >
      <span
        class="hidden truncate text-md ml-2 font-semibold tracking-tight transition-colors group-hover:text-[var(--sec)] sm:inline"
      >
        Riasat Mahbub
      </span>
    </a>

    <div class="flex min-w-0 items-center gap-2 lg:gap-5">
      <ul class="hidden items-center gap-4 lg:flex xl:gap-6">
        {
          navItems.map((item) => (
            <li class="shrink-0">
              <a
                href={item.href}
                data-nav-link
                class="nav-link relative inline-flex py-2 text-xs font-medium text-[var(--white-icon)] transition-colors hover:text-[var(--white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] xl:text-sm"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle embedded />

      <button
        id="nav-menu-button"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg border border-[var(--white-icon-tr)] text-[var(--white-icon)] transition-colors hover:bg-[var(--white-icon-tr)] hover:text-[var(--white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] lg:hidden"
        aria-controls="nav-drawer"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>
</div>

<div
  id="nav-drawer"
  class="nav-drawer pointer-events-none fixed inset-0 z-[90] invisible opacity-0 transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
  inert
>
  <button
    id="nav-backdrop"
    type="button"
    class="absolute inset-0 cursor-default bg-[var(--background)]/80 backdrop-blur-sm"
    aria-label="Close navigation menu"
  ></button>

  <div
    class="nav-panel absolute right-4 top-20 max-h-[calc(100dvh-6rem)] w-[calc(100%-2rem)] max-w-sm overflow-y-auto rounded-xl border border-[var(--white-icon-tr)] bg-[var(--background)] p-4 shadow-2xl sm:right-6 sm:w-96"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nav-panel-title"
    tabindex="-1"
  >
    <div class="flex items-center justify-between border-b border-[var(--white-icon-tr)] pb-3">
      <p
        id="nav-panel-title"
        class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Menu
      </p>
      <button
        id="nav-close-button"
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-lg text-[var(--white-icon)] transition-colors hover:bg-[var(--white-icon-tr)] hover:text-[var(--white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
        aria-label="Close navigation menu"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <ul class="mt-2 divide-y divide-[var(--white-icon-tr)]">
      {
        navItems.map((item, index) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              data-drawer-link
              class="nav-drawer-link flex items-center gap-4 px-2 py-3.5 text-[var(--white-icon)] transition-colors hover:text-[var(--white)] focus-visible:rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
            >
              <span class="w-7 shrink-0 text-xs font-semibold tracking-[0.14em] text-[var(--sec)]">
                0{index + 1}
              </span>
              <span class="flex-1 text-base font-medium">{item.label}</span>
              <svg
                class="size-4 shrink-0 opacity-50"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const nav = document.getElementById("main-nav");
  const menuButton = document.getElementById("nav-menu-button");
  const closeButton = document.getElementById("nav-close-button");
  const backdrop = document.getElementById("nav-backdrop");
  const drawer = document.getElementById("nav-drawer");
  const drawerPanel = drawer?.querySelector<HTMLElement>(".nav-panel");
  const activeNavLinks = document.querySelectorAll<HTMLAnchorElement>(
    "[data-nav-link]",
  );
  const sections = document.querySelectorAll<HTMLElement>("section[id]");

  const setMenuOpen = (isOpen: boolean) => {
    if (!drawer || !menuButton) return;

    drawer.classList.toggle("is-open", isOpen);
    drawer.setAttribute("aria-hidden", String(!isOpen));
    menuButton.setAttribute("aria-expanded", String(isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? "Close navigation menu" : "Open navigation menu",
    );

    if (isOpen) {
      drawer.removeAttribute("inert");
      document.body.style.overflow = "hidden";
      window.setTimeout(() => drawerPanel?.focus(), 0);
    } else {
      drawer.setAttribute("inert", "");
      document.body.style.overflow = "";
    }
  };

  const updateNav = () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });
  closeButton?.addEventListener("click", () => setMenuOpen(false));
  backdrop?.addEventListener("click", () => setMenuOpen(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(
    (anchor) => {
      anchor.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.button !== 0) return;

        const href = anchor.getAttribute("href");
        const targetId = href?.slice(1);
        const target = targetId ? document.getElementById(targetId) : null;

        if (!target) return;

        event.preventDefault();
        setMenuOpen(false);
        target.scrollIntoView({ behavior: "smooth" });
        window.history.replaceState(null, "", href);
      });
    },
  );

  const activateNavLink = (sectionId: string) => {
    activeNavLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === `#${sectionId}`;
      link.classList.toggle("active", isActive);

      if (isActive) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  if ("IntersectionObserver" in window) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activateNavLink((entry.target as HTMLElement).id);
          }
        });
      },
      {
        threshold: 0,
        rootMargin: "-20% 0px -70% 0px",
      },
    );

    sections.forEach((section) => sectionObserver.observe(section));
  } else {
    activateNavLink("home");
  }

  updateNav();
  window.addEventListener("scroll", updateNav, { passive: true });
</script>

<style>
  .site-header.is-scrolled {
    background-color: var(--background);
    border-color: var(--white-icon-tr);
    box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--background) 24%, transparent);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    content: "";
    background: var(--sec);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--white);
  }

  .nav-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
  }

  .nav-panel {
    transform: translateY(-0.5rem);
    transition: transform 300ms ease;
  }

  .nav-drawer.is-open .nav-panel {
    transform: translateY(0);
  }

  .nav-drawer-link.active {
    color: var(--white);
    box-shadow: inset 2px 0 0 var(--sec);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-link::after,
    .nav-panel {
      transition: none;
    }
  }
</style>
