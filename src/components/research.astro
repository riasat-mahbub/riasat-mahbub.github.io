---
interface Paper {
  title: string;
  link: string;
  description: string;
  date: string;
  dateValue: string;
}

const research: Paper[] = [
  {
    title:
      "Understanding Code Smells and Refactoring Practices in Simulation Modelling Systems",
    link: "https://dalspace.library.dal.ca/items/54690d16-478b-4d03-b2fd-12a95080d753",
    description:
      "Master’s thesis examining software quality problems, code-smell patterns, and refactoring effectiveness across 482 open-source repositories.",
    date: "October 2025",
    dateValue: "2025-10",
  },
  {
    title:
      "Exploring Code Smells in Simulation Modelling Systems: Effectiveness, Risks and Impacts",
    link: "https://www.nationalacademies.org/events/886",
    description:
      "Study of how effective and risky refactoring is across simulation modelling systems.",
    date: "January 2026",
    dateValue: "2026-01",
  },
  {
    title:
      "On the Prevalence, Evolution, and Impact of Code Smells in Simulation Modelling",
    link: "https://www.arxiv.org/abs/2409.03957",
    description:
      "Empirical analysis of code smells across 155 simulation and 327 traditional GitHub projects.",
    date: "December 2024",
    dateValue: "2024-12",
  },
  {
    title: "City Recommender System: A Comparative Study of AI-Driven Approaches",
    link: "https://link.springer.com/chapter/10.1007/978-3-031-73125-9_17",
    description:
      "Comparison of classic machine-learning methods and a neural network for personalized city recommendations.",
    date: "November 2024",
    dateValue: "2024-11",
  },
  {
    title: "Neural Network Architecture for the Classification of Alzheimer's Disease from Brain MRI",
    link: "https://ieeexplore.ieee.org/document/9707412",
    description:
      "Neural-network approach to classifying Alzheimer’s disease from brain MRI data.",
    date: "December 2021",
    dateValue: "2021-12",
  },
];
---

<section
  class="border-t-2 border-[var(--white-icon-tr)] px-4 py-20 text-[var(--white)] md:px-8 md:py-28"
  id="research"
>
  <div class="mx-auto max-w-5xl">
    <header class="max-w-2xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Academic work
      </p>
      <h2 class="text-4xl font-medium tracking-tight md:text-6xl">Research</h2>
      <p
        class="mt-5 max-w-xl text-base leading-relaxed text-[var(--white-icon)] md:text-lg"
      >
        I study how software quality and refactoring shape the maintainability
        of simulation software, with additional work in applied machine
        learning.
      </p>
    </header>

    <div class="mt-12 border-y border-[var(--white-icon-tr)] md:mt-16">
      {
        research.map((paper, index) => (
          <a
            href={paper.link}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group grid gap-5 py-7 focus-visible:rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)] sm:grid-cols-[minmax(0,1fr)_10rem] sm:gap-8 sm:py-8",
              index > 0 && "border-t border-[var(--white-icon-tr)]",
            ]}
          >
            <div class="min-w-0">
              <h3
                class="max-w-3xl text-lg font-medium leading-snug tracking-tight transition-colors sm:text-xl md:text-2xl"
              >
                {paper.title}
              </h3>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--white-icon)] sm:text-base">
                {paper.description}
              </p>
            </div>

            <div
              class="flex items-center justify-end gap-5 text-xs font-medium uppercase tracking-[0.12em] text-[var(--white-icon)] sm:flex-col sm:items-end sm:justify-start sm:gap-3 sm:pt-1 sm:text-sm"
            >
              <time datetime={paper.dateValue}>{paper.date}</time>
              <span class="inline-flex items-center gap-2 transition-colors group-hover:text-[var(--sec)]">
                Read
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4"
                  aria-hidden="true"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
